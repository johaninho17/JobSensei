{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "incremental": true,
    "tsBuildInfoFile": "dist-electron/.tsbuildinfo",
    "types": ["node", "electron"]
  },
  "include": ["electron/**/*.ts", "src/shared/**/*.ts"]
}
