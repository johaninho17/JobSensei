{
  "name": "jobsensei",
  "version": "0.2.1",
  "private": true,
  "description": "A local-first career workspace for grounded job applications.",
  "author": "JobSensei Team",
  "main": "dist-electron/electron/main.js",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "node-pty@1.1.0": true
  },
  "scripts": {
    "predev": "tsc -p tsconfig.electron.json",
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http-get://127.0.0.1:5173 && electron . --dev\"",
    "build": "npm run clean && tsc -b && vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "context:snapshot": "tsc -p tsconfig.electron.json && node dist-electron/electron/evidence-snapshot.js",
    "application:finalize": "tsc -p tsconfig.electron.json && node dist-electron/electron/application-finalize.js",
    "jd:fetch": "tsc -p tsconfig.electron.json && node dist-electron/electron/jd-fetch.js",
    "application:validate": "tsc -p tsconfig.electron.json && node dist-electron/electron/application-validation-cli.js",
    "demo:seed": "node scripts/seed-demo.mjs",
    "demo:reset": "node scripts/seed-demo.mjs --clean",
    "migrate:job-descriptions": "node scripts/migrate-original-jds.mjs",
    "start": "electron .",
    "postinstall": "node scripts/ensure-pty-helper.cjs",
    "pack:binaries": "node scripts/prepare-bundled-binaries.mjs",
    "dist": "npm run pack:binaries && npm run build && electron-builder",
    "dist:mac": "node scripts/prepare-bundled-binaries.mjs --platform=mac && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:win": "node scripts/prepare-bundled-binaries.mjs --platform=win && npm run build && electron-builder --win",
    "interview:context": "tsc -p tsconfig.electron.json && node dist-electron/electron/interview-context.js",
    "interview:check": "tsc -p tsconfig.electron.json && node dist-electron/electron/interview-check.js",
    "clean": "node -e \"for (const dir of ['dist-electron', 'dist-renderer']) require('node:fs').rmSync(dir, { recursive: true, force: true })\""
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "mammoth": "^1.13.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "10.0.6",
    "electron": "43.8.3",
    "electron-builder": "^26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wait-on": "9.5.1"
  },
  "build": {
    "appId": "com.jobsensei.desktop",
    "productName": "JobSensei",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node-pty/**/*"
    ],
    "extraResources": [
      {
        "from": "build-resources/bin/${os}",
        "to": "bin",
        "filter": [
          "*"
        ]
      },
      {
        "from": ".agents",
        "to": "agents",
        "filter": [
          "skills/**/*",
          "rules/**/*",
          "workflows/**/*"
        ]
      },
      {
        "from": "AGENTS.md",
        "to": "AGENTS.md"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build-config/entitlements.mac.plist",
      "entitlementsInherit": "build-config/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JobSensei"
    },
    "afterPack": "scripts/adhoc-sign-mac.cjs"
  }
}
